# Compose reads .env for interpolation. Local review commands use exported env vars.
APP_ORIGIN=https://review.example.com
# Server-side internal URL. Include Jellyfin's base path if configured.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_NETWORK=media
# Generation only; create in Jellyfin Dashboard > API Keys. Not used for --input.
JELLYFIN_API_KEY=
REVIEW_TIMEZONE=Europe/London
# Match the owner of ./data ./cache and readable ./input. Never use UID 0.
REVIEW_UID=10001
REVIEW_GID=10001
# Local CLI offline serving. compose.offline.yaml sets these explicitly.
# No JELLYFIN_URL or Jellyfin network is required in offline serving mode.
REVIEW_AUTH_MODE=jellyfin
# Set to a private file outside web/ and data/ when REVIEW_AUTH_MODE=offline.
REVIEW_AUTH_FILE=

# Read-only Jellystat PostgreSQL access for scripts/generate-review.sh.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=jfstat
PGUSER=review_readonly
# Set the database password in single quotes to preserve shell special characters.
PGPASSWORD=''
# Optional honest description of the history collection window and gaps.
# REVIEW_COVERAGE='Collected 2025-01-01 through 2025-12-31; no known gaps'
